#!/usr/bin/env bash
# Minimal wl-paste stub: serve host-synced PNG for Claude Code image paste.
set -u

CLIP_DIR="${AGENTS_CLIPBOARD_DIR:-/var/agents-clipboard}"
IMG="${CLIP_DIR}/image.png"

has_image() {
  [[ -f "$IMG" && -s "$IMG" ]]
}

list_only=0
type=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--list)
      list_only=1
      shift
      ;;
    --type|-t)
      shift
      type="${1:-}"
      [[ $# -gt 0 ]] && shift
      ;;
    -n|--no-newline|--watch|-w|--primary|-p|--version|-v|--help|-h)
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [[ "$list_only" -eq 1 ]]; then
  if has_image; then
    printf '%s\n' "image/png"
    exit 0
  fi
  exit 1
fi

if ! has_image; then
  exit 1
fi

case "$type" in
  ""|image/png|image/jpeg|image/jpg|image/gif|image/webp|image/bmp)
    cat "$IMG"
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
