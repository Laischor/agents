# Optional overrides for gpu-bridge.sh (copy to data/gpu/config.env).
# Paths must be executable macOS binaries on the host.

# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# GODOT_BIN=/Applications/Godot.app/Contents/MacOS/Godot
# GODOT_BIN=/opt/homebrew/bin/godot

# GPU_BRIDGE_POLL=0.5
# GPU_JOB_TIMEOUT=600
