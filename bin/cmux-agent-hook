#!/usr/bin/env bash
# Claude/Cursor hook helper → host cmux-bridge via container `cmux` stub.
# Usage: cmux-agent-hook <claude|cursor> <event>
# Reads agent hook JSON from stdin.
#
# Always `cmux notify` — wrap sessions go to the browser; others hit the host
# bridge (OSC + afplay). Cursor sanitizes PATH and drops WRAP_SESSION_ID, so
# we detect wrap via the tmux socket (or WRAP_SESSION_ID when present).
# Cursor: wire only the `stop` event (not afterAgentResponse) — both fire per turn.
set -euo pipefail

agent="${1:-}"
event="${2:-}"
if [[ -z "$agent" || -z "$event" ]]; then
  echo "usage: cmux-agent-hook <claude|cursor> <event>" >&2
  exit 2
fi

input="$(cat || true)"

eval "$(
  printf '%s' "$input" | python3 -c '
import json, shlex, sys
agent, event = sys.argv[1:3]
raw = sys.stdin.read()
data = {}
try:
    data = json.loads(raw) if raw.strip() else {}
except json.JSONDecodeError:
    data = {}
title = None
body = None
notif = data.get("notification") if isinstance(data.get("notification"), dict) else {}
if notif.get("title"):
    title = str(notif["title"])
for key in ("body", "message", "subtitle"):
    if notif.get(key):
        body = str(notif[key])
        break
if not body:
    for key in ("message", "body", "text", "status", "last_assistant_message"):
        if data.get(key):
            body = str(data[key])
            break
cwd = data.get("cwd") or ""
project = cwd.rstrip("/").split("/")[-1] if cwd else ""
if not title:
    title = f"{agent.title()}" + (f" [{project}]" if project else "")
event_l = (event or "").lower()
if not body:
    if event_l in ("notification", "needs-input"):
        body = "Waiting for input"
    elif event_l in ("stop", "agent-response"):
        body = "Done — needs attention"
    else:
        body = event
title = title.replace("\n", " ")[:80]
body = body.replace("\n", " ")[:160]
print(f"title={shlex.quote(title)}")
print(f"body={shlex.quote(body)}")
' "$agent" "$event"
)"

title="${title:-${agent}}"
body="${body:-$event}"

wrap_cmux="/usr/local/share/wrap/bin/cmux"
if [[ -n "${WRAP_SESSION_ID:-}" || "${TMUX:-}" == *wrap.tmux* ]]; then
  if [[ -f "$wrap_cmux" ]]; then
    python3 "$wrap_cmux" notify --title "$title" --body "$body" >/dev/null 2>&1 || true
    exit 0
  fi
fi

cmux notify --title "$title" --body "$body" >/dev/null 2>&1 || true
exit 0
