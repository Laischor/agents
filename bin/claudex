#!/usr/bin/env bash
# Claude Code → GPT-5.6 Sol via CLIProxyAPI (same path for dclaudex and Hermes sandbox).
set -euo pipefail

if [[ -z "${CLIPROXY_API_KEY:-}" ]]; then
  echo "error: CLIPROXY_API_KEY is not set" >&2
  exit 1
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "error: claude not found on PATH" >&2
  exit 1
fi

# Prefer Compose DNS; Hermes sandbox is outside that network → host gateway.
proxy_base_url() {
  if getent hosts cli-proxy-api >/dev/null 2>&1; then
    printf '%s\n' "http://cli-proxy-api:8317"
    return
  fi
  if getent hosts host.docker.internal >/dev/null 2>&1; then
    printf '%s\n' "http://host.docker.internal:8317"
    return
  fi
  printf '%s\n' "http://172.17.0.1:8317"
}

export ANTHROPIC_BASE_URL
ANTHROPIC_BASE_URL="$(proxy_base_url)"
export ANTHROPIC_AUTH_TOKEN="$CLIPROXY_API_KEY"
# Empty key forces Claude Code to use ANTHROPIC_AUTH_TOKEN against the proxy
export ANTHROPIC_API_KEY=""
export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDE_CODE_SUBAGENT_MODEL:-gpt-5.6-sol}"
export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT="${CLAUDE_CODE_ALWAYS_ENABLE_EFFORT:-1}"
export CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY="${CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY:-3}"
export ENABLE_TOOL_SEARCH="${ENABLE_TOOL_SEARCH:-false}"

exec claude --model gpt-5.6-sol "$@"
