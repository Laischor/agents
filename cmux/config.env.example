# Optional overrides for cmux-bridge.sh (copy to data/cmux/config.env).
# CMUX_BIN=/Applications/cmux.app/Contents/MacOS/cmux
# CMUX_BRIDGE_POLL=0.25
# CMUX_JOB_TIMEOUT=15
# Host afplay after notify/hooks (primary delivery is OSC → registered TTY):
# CMUX_BRIDGE_SOUND=1
# CMUX_BRIDGE_SOUND_FILE=/System/Library/Sounds/Tink.aiff
