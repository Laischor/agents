# Paths — use absolute paths (Compose does not expand ~)
# Where your code lives on the host (mounted 1:1 into the container)
HOST_PROJECTS=/Users/YOU/Documents/projects

# Absolute path to this agents repo
# start.sh / run.sh set this automatically if missing
AGENTS_DIR=/Users/YOU/Documents/projects/agents

# Memory — defaults match current hardcodes; override as needed
# Colima VM RAM in GiB (only applied when Colima is started by start.sh)
COLIMA_MEMORY=4
# agents container hard mem_limit (Compose syntax: 3g, 4g, …)
AGENTS_MEM_LIMIT=3g

# wrap — native Claude/Cursor tmux + OpenCode HTTP on http://127.0.0.1:3000
# (0 = do not auto-start). Same CLI process as the terminal; no extra harness.
# Hermes is added as a wrap agent when HERMES=1 (below).
AGENTS_WRAP_SERVE=1
# WRAP_PUBLIC_URL=http://127.0.0.1:3000

# Cursor CLI (https://cursor.com/dashboard → API Keys)
CURSOR_API_KEY=

# LLM providers (use whichever you authenticate with)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# GitHub CLI — optional. On macOS the OAuth token is in Keychain; start.sh/run.sh
# pull it via `gh auth token` and write data/gh + data/gitconfig for Linux
# containers. Set here only to override.
# GH_TOKEN=

# Hermes Agent (Nous Research) — set to 1 to start hermes + firecrawl (Molx)
# First-time: agents hermes-setup  then  HERMES=1 and ./start.sh
# Dashboard:  http://127.0.0.1:9119 — auth auto-generated by start.sh if empty
# Wrap: Hermes appears as an agent at http://127.0.0.1:3000 when this is 1
HERMES=0
# UID for data/hermes bind mount (must be non-zero).
# macOS Docker Desktop: use `id -u` / `id -g` (often 501) — NOT 1000.
# start.sh fills these in automatically when empty.
HERMES_UID=
HERMES_GID=
# Gateway OpenAI-compatible API (:8642). start.sh generates if empty (min 8 chars).
HERMES_API_SERVER_KEY=
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=

# Scrape/search API — Molx as Firecrawl (single container, :3002).
# Also started automatically when HERMES=1. Set to 1 to run it without Hermes.
# Official Firecrawl OSS is a 5-service stack; we use this substitute instead.
# API: http://127.0.0.1:3002  (from agents/hermes: http://firecrawl:3002)
FIRECRAWL=0
# FIRECRAWL_PORT=3002
# FIRECRAWL_API_URL=http://firecrawl:3002
# FIRECRAWL_API_KEY=          # optional Bearer token
# FIRECRAWL_MODEL_NAME=       # optional, for LLM extract (uses OPENAI_API_KEY)
