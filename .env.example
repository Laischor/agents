# Paths — use absolute paths (Compose does not expand ~)
# Where your code lives on the host (mounted 1:1 into the container)
HOST_PROJECTS=/Users/YOU/Documents/projects

# Absolute path to this agents repo (Hermes docker sandbox bind-mounts data/*)
# start.sh / run.sh set this automatically if missing
AGENTS_DIR=/Users/YOU/Documents/projects/agents

# Cursor CLI (https://cursor.com/dashboard → API Keys)
CURSOR_API_KEY=

# LLM providers (use whichever you authenticate with)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# GitHub CLI — optional. On macOS the OAuth token is in Keychain; start.sh/run.sh
# pull it via `gh auth token` automatically. Set here only to override.
# GH_TOKEN=

# Hermes Agent (Nous Research) — set to 1 to start hermes + hermes-webui + searxng
# First-time: agents hermes-setup  then  HERMES=1 and ./start.sh
# WebUI chat: http://127.0.0.1:8787 — optional password for non-localhost exposure
# Dashboard:  http://127.0.0.1:9119 — auth auto-generated by start.sh if empty
HERMES=0
HERMES_WEBUI_PASSWORD=
# Shared UID for gateway + webui on data/hermes (must be non-zero).
# macOS Docker Desktop: use `id -u` / `id -g` (often 501) — NOT 1000.
# start.sh fills these in automatically when empty.
HERMES_UID=
HERMES_GID=
# Gateway OpenAI-compatible API (:8642) — WebUI routes chat through this.
# start.sh generates if empty (min 8 chars).
HERMES_API_SERVER_KEY=
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=
